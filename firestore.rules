rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'claimedLoginBonus', 'diamonds', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('claimedLoginBonus' in data) || data.claimedLoginBonus is bool) &&
        (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0)) &&
        data.createdAt is string && data.updatedAt is string;
    }

    // Validation for CareerSave
    function isValidCareerSave(data) {
      return data.keys().hasAll(['id', 'userId', 'clubName', 'currentSport', 'savePayload', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clubName', 'currentSport', 'reputation', 'coins', 'diamonds', 'vipPoints', 'currentChapter', 'currentMissionId', 'savePayload', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.clubName is string && data.clubName.size() > 0 && data.clubName.size() <= 100 &&
        data.currentSport is string && (data.currentSport == 'football' || data.currentSport == 'basketball') &&
        data.savePayload is string && data.savePayload.size() <= 100000 &&
        data.createdAt is string && data.updatedAt is string;
    }

    // Validation for CommunityTactic
    function isValidCommunityTactic(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'title', 'sport', 'formation', 'mentality', 'pressing', 'likesCount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'authorId', 'authorName', 'title', 'sport', 'formation', 'mentality', 'pressing', 'likesCount', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.sport is string && (data.sport == 'football' || data.sport == 'basketball') &&
        data.formation is string && data.formation.size() <= 20 &&
        data.mentality is string && data.mentality.size() <= 30 &&
        data.pressing is string && data.pressing.size() <= 30 &&
        data.likesCount is number && data.likesCount >= 0 &&
        data.createdAt is string;
    }

    // Validation for Layer 2: UserClubSave
    function isValidUserClubSave(data) {
      return data.keys().hasAll(['id', 'userId', 'clubName', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clonedFromClubId', 'clubName', 'leagueId', 'divisionName', 'boardTrust', 'fanMood', 'coins', 'diamonds', 'reputation', 'seasonYear', 'updatedAt', 'clonedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.clubName is string && data.clubName.size() > 0 && data.clubName.size() <= 100 &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0)) &&
        data.updatedAt is string;
    }

    // Validation for Layer 2: UserPlayerSave
    function isValidUserPlayerSave(data) {
      return data.keys().hasAll(['id', 'userId', 'realName', 'baseOverall', 'currentOverall']) &&
        data.keys().hasOnly(['id', 'userId', 'realName', 'photoUrl', 'realPosition', 'nationality', 'isRealDataPlayer', 'baseOverall', 'currentOverall', 'potential', 'trainingBonus', 'vipBonus', 'fatiguePenalty', 'morale', 'isRatingEstimated', 'lastTrainingDate']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.realName is string && data.realName.size() > 0 && data.realName.size() <= 100 &&
        data.baseOverall is number && data.baseOverall >= 30 && data.baseOverall <= 99 &&
        data.currentOverall is number && data.currentOverall >= 30 && data.currentOverall <= 99;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // Subcollection: User career saves
      match /careerSaves/{saveId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(saveId) && isValidCareerSave(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(saveId) && isValidCareerSave(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(saveId);
      }
    }

    // Shared community tactics
    match /tactics/{tacticId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(tacticId) && isValidCommunityTactic(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(tacticId) && isValidCommunityTactic(incoming()) && (
        (incoming().authorId == existing().authorId && incoming().authorId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount >= 0 && incoming().authorId == existing().authorId)
      );
      allow delete: if isSignedIn() && isValidId(tacticId) && existing().authorId == request.auth.uid;
    }

    // ==========================================
    // LAYER 1: Shared Read-Only Official Cache
    // Globally readable by all clients, strictly protected from unauthorized direct writes
    // ==========================================
    match /leagues_cache/{leagueId} {
      allow get, list: if true;
      allow write: if false; // Mutated solely via server backend / sync function
    }

    match /clubs_cache/{clubId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /players_cache/{playerId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /sync_logs/{logId} {
      allow get, list: if true;
      allow write: if false;
    }

    // ==========================================
    // LAYER 2: Isolated User Clones & Personal Saves
    // Path: /user_saves/{userId}/club and subcollection players/{playerId}
    // Fully protected by isOwner(userId)
    // ==========================================
    match /user_saves/{userId} {
      allow get: if isOwner(userId);
      allow write: if false;

      match /club {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserClubSave(incoming());
        allow update: if isOwner(userId) && isValidUserClubSave(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);

        match /players/{playerId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(playerId) && isValidUserPlayerSave(incoming());
          allow update: if isOwner(userId) && isValidId(playerId) && isValidUserPlayerSave(incoming()) && incoming().userId == existing().userId;
          allow delete: if isOwner(userId) && isValidId(playerId);
        }
      }
    }
  }
}
