rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'displayName', 'email', 'photoURL', 'claimedLoginBonus', 'diamonds', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id == request.auth.uid &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('claimedLoginBonus' in data) || data.claimedLoginBonus is bool) &&
        (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0)) &&
        data.createdAt is string && data.updatedAt is string;
    }

    // Validation for CareerSave
    function isValidCareerSave(data) {
      return data.keys().hasAll(['id', 'userId', 'clubName', 'currentSport', 'savePayload', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clubName', 'currentSport', 'reputation', 'coins', 'diamonds', 'vipPoints', 'currentChapter', 'currentMissionId', 'savePayload', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.clubName is string && data.clubName.size() > 0 && data.clubName.size() <= 100 &&
        data.currentSport is string && (data.currentSport == 'football' || data.currentSport == 'basketball') &&
        data.savePayload is string && data.savePayload.size() <= 100000 &&
        data.createdAt is string && data.updatedAt is string;
    }

    // Validation for CommunityTactic
    function isValidCommunityTactic(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'title', 'sport', 'formation', 'mentality', 'pressing', 'likesCount', 'createdAt']) &&
        data.keys().hasOnly(['id', 'authorId', 'authorName', 'title', 'sport', 'formation', 'mentality', 'pressing', 'likesCount', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.sport is string && (data.sport == 'football' || data.sport == 'basketball') &&
        data.formation is string && data.formation.size() <= 20 &&
        data.mentality is string && data.mentality.size() <= 30 &&
        data.pressing is string && data.pressing.size() <= 30 &&
        data.likesCount is number && data.likesCount >= 0 &&
        data.createdAt is string;
    }

    // Validation for Layer 2: UserClubSave
    function isValidUserClubSave(data) {
      return data.keys().hasAll(['id', 'userId', 'clubName', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'clonedFromClubId', 'clubName', 'leagueId', 'divisionName', 'boardTrust', 'fanMood', 'coins', 'diamonds', 'reputation', 'seasonYear', 'updatedAt', 'clonedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.clubName is string && data.clubName.size() > 0 && data.clubName.size() <= 100 &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('diamonds' in data) || (data.diamonds is number && data.diamonds >= 0)) &&
        data.updatedAt is string;
    }

    // Validation for Layer 2: UserPlayerSave
    function isValidUserPlayerSave(data) {
      return data.keys().hasAll(['id', 'userId', 'realName', 'baseOverall', 'currentOverall']) &&
        data.keys().hasOnly(['id', 'userId', 'realName', 'photoUrl', 'realPosition', 'nationality', 'isRealDataPlayer', 'baseOverall', 'currentOverall', 'potential', 'trainingBonus', 'vipBonus', 'fatiguePenalty', 'morale', 'isRatingEstimated', 'lastTrainingDate']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.realName is string && data.realName.size() > 0 && data.realName.size() <= 100 &&
        data.baseOverall is number && data.baseOverall >= 30 && data.baseOverall <= 99 &&
        data.currentOverall is number && data.currentOverall >= 30 && data.currentOverall <= 99;
    }

    // Validation for Tactical Duel PvP Room
    function isValidDuelRoom(data) {
      return data.keys().hasAll(['id', 'hostUid', 'hostClubName', 'status', 'round', 'maxRounds', 'hostHp', 'guestHp', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() <= 64 &&
        data.hostUid is string && data.hostUid.size() <= 128 &&
        data.hostClubName is string && data.hostClubName.size() > 0 && data.hostClubName.size() <= 100 &&
        data.status is string && (data.status == 'waiting' || data.status == 'active' || data.status == 'finished' || data.status == 'abandoned') &&
        data.round is number && data.round >= 1 && data.round <= 20 &&
        data.maxRounds is number && data.maxRounds >= 1 && data.maxRounds <= 20 &&
        data.hostHp is number && data.hostHp >= 0 && data.hostHp <= 100 &&
        data.guestHp is number && data.guestHp >= 0 && data.guestHp <= 100 &&
        (!('guestUid' in data) || data.guestUid == null || (data.guestUid is string && data.guestUid.size() <= 128)) &&
        (!('guestClubName' in data) || data.guestClubName == null || (data.guestClubName is string && data.guestClubName.size() <= 100)) &&
        (!('winner' in data) || data.winner == null || data.winner == 'host' || data.winner == 'guest' || data.winner == 'draw') &&
        data.createdAt is string && data.updatedAt is string;
    }

    // Validation for Tactical Duel Player Order
    function isValidDuelOrder(data) {
      return data.keys().hasAll(['uid', 'round', 'pieceId', 'stance', 'submittedAt']) &&
        data.keys().hasOnly(['uid', 'round', 'pieceId', 'stance', 'submittedAt']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.round is number && data.round >= 1 && data.round <= 20 &&
        data.pieceId is string && data.pieceId.size() > 0 && data.pieceId.size() <= 64 &&
        data.stance is string && (data.stance == 'attack' || data.stance == 'defend' || data.stance == 'flank') &&
        data.submittedAt is string;
    }

    // Helper: is user an authorized participant of this room
    function isRoomParticipant(room) {
      return isSignedIn() && (request.auth.uid == room.hostUid || (room.guestUid != null && request.auth.uid == room.guestUid));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // Subcollection: User career saves
      match /careerSaves/{saveId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(saveId) && isValidCareerSave(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(saveId) && isValidCareerSave(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(saveId);
      }
    }

    // Shared community tactics
    match /tactics/{tacticId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(tacticId) && isValidCommunityTactic(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(tacticId) && isValidCommunityTactic(incoming()) && (
        (incoming().authorId == existing().authorId && incoming().authorId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']) && incoming().likesCount >= 0 && incoming().authorId == existing().authorId)
      );
      allow delete: if isSignedIn() && isValidId(tacticId) && existing().authorId == request.auth.uid;
    }

    // ==========================================
    // LAYER 1: Shared Read-Only Official Cache
    // Globally readable by all clients, strictly protected from unauthorized direct writes
    // ==========================================
    match /leagues_cache/{leagueId} {
      allow get, list: if true;
      allow write: if false; // Mutated solely via server backend / sync function
    }

    match /clubs_cache/{clubId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /players_cache/{playerId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /sync_logs/{logId} {
      allow get, list: if true;
      allow write: if false;
    }

    // ==========================================
    // LAYER 2: Isolated User Clones & Personal Saves
    // Path: /user_saves/{userId}/club and subcollection players/{playerId}
    // Fully protected by isOwner(userId)
    // ==========================================
    match /user_saves/{userId} {
      allow get: if isOwner(userId);
      allow write: if false;

      match /club {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserClubSave(incoming());
        allow update: if isOwner(userId) && isValidUserClubSave(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);

        match /players/{playerId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidId(playerId) && isValidUserPlayerSave(incoming());
          allow update: if isOwner(userId) && isValidId(playerId) && isValidUserPlayerSave(incoming()) && incoming().userId == existing().userId;
          allow delete: if isOwner(userId) && isValidId(playerId);
        }
      }
    }

    // ==========================================
    // LAYER 3: Tactical Battle Maker Realtime PvP Rooms
    // Path: /duel_rooms/{roomId}
    // Subcollection: /orders/{orderUid}
    // Zero-Knowledge / Anti-Cheat Simultaneous Stance Reveal
    // ==========================================
    match /duel_rooms/{roomId} {
      // Allow reading room document if participant or joining (waiting room)
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      // Create room (Host initialization)
      allow create: if isSignedIn() &&
        incoming().hostUid == request.auth.uid &&
        incoming().status == 'waiting' &&
        incoming().round == 1 &&
        isValidDuelRoom(incoming());

      // Update room state (Join room, advance rounds, resolve match)
      allow update: if isSignedIn() &&
        // Joining empty waiting room as guest
        ((existing().status == 'waiting' &&
          existing().guestUid == null &&
          incoming().guestUid == request.auth.uid &&
          incoming().status == 'active' &&
          isValidDuelRoom(incoming())) ||
        // State updates by registered participants (resolving rounds or leaving)
        (isRoomParticipant(existing()) &&
          isValidDuelRoom(incoming())));

      allow delete: if isSignedIn() && existing().hostUid == request.auth.uid;

      // -----------------------------------------------------------------------
      // SECRET ORDERS SUBCOLLECTION (Zero-Knowledge Stance Concealment)
      // Path: /duel_rooms/{roomId}/orders/{orderUid}
      // Anti-Cheat Guarantee:
      // 1. You can only create/update your OWN order doc (orderUid == request.auth.uid).
      // 2. You can only read opponent's order AFTER you have submitted your own order for the current round!
      // -----------------------------------------------------------------------
      match /orders/{orderUid} {
        // Player reading an order:
        // - Always allowed to read their OWN order document.
        // - Allowed to read OPPONENT's order ONLY IF the requester's own order document exists
        //   and was submitted for the SAME round (both committed their stance).
        allow get: if isSignedIn() && (
          request.auth.uid == orderUid ||
          (
            exists(/databases/$(database)/documents/duel_rooms/$(roomId)/orders/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/duel_rooms/$(roomId)/orders/$(request.auth.uid)).data.round == resource.data.round
          )
        );

        // Disallow arbitrary collection listing to prevent leaking opponent choices via query
        allow list: if false;

        // Player submitting their secret choice
        allow create: if isSignedIn() &&
          request.auth.uid == orderUid &&
          isValidDuelOrder(incoming()) &&
          incoming().round == get(/databases/$(database)/documents/duel_rooms/$(roomId)).data.round;

        // Player updating their secret choice for the current round
        allow update: if isSignedIn() &&
          request.auth.uid == orderUid &&
          isValidDuelOrder(incoming()) &&
          incoming().round == get(/databases/$(database)/documents/duel_rooms/$(roomId)).data.round;

        allow delete: if isSignedIn() && request.auth.uid == orderUid;
      }
    }

    // ==========================================
    // LAYER 4: Gift & Redeem Codes System
    // Path: /redeem_codes/{code}
    // Subcollection: /redeem_codes/{code}/redemptions/{uid}
    // ==========================================
    match /redeem_codes/{code} {
      // Clients can inspect an exact code document ONLY if they know its code.
      // Listing is strictly forbidden to prevent scraping/discovering hidden codes.
      allow get: if isSignedIn();
      allow list: if false;

      // Clients can NEVER create, update, or delete redeem codes.
      // Only Firebase Admin SDK (via GitHub Actions) can manage codes.
      allow create, update, delete: if false;

      // Subcollection: per-user redemption receipt
      match /redemptions/{uid} {
        // Player can only inspect their own redemption receipt
        allow get: if isSignedIn() && (request.auth.uid == uid);
        allow list: if false;

        // Player can create a redemption receipt if:
        // 1. Signed in and writing their OWN uid receipt (uid == request.auth.uid).
        // 2. The parent code exists and is active.
        // 3. If the code is restricted to a developer UID, request.auth.uid MUST match.
        // 4. Recorded rewards MUST match the actual parent code's reward fields.
        allow create: if isSignedIn() &&
          request.auth.uid == uid &&
          incoming().uid == request.auth.uid &&
          incoming().code == code &&
          exists(/databases/$(database)/documents/redeem_codes/$(code)) &&
          get(/databases/$(database)/documents/redeem_codes/$(code)).data.active == true &&
          (
            get(/databases/$(database)/documents/redeem_codes/$(code)).data.restrictedToUid == "" ||
            get(/databases/$(database)/documents/redeem_codes/$(code)).data.restrictedToUid == request.auth.uid
          ) &&
          incoming().rewardCoins == get(/databases/$(database)/documents/redeem_codes/$(code)).data.rewardCoins &&
          incoming().rewardDiamonds == get(/databases/$(database)/documents/redeem_codes/$(code)).data.rewardDiamonds &&
          incoming().rewardTrainingPoints == get(/databases/$(database)/documents/redeem_codes/$(code)).data.rewardTrainingPoints;

        // Dev codes allow multiple uses: developer can update timestamp on re-test
        allow update: if isSignedIn() &&
          request.auth.uid == uid &&
          exists(/databases/$(database)/documents/redeem_codes/$(code)) &&
          get(/databases/$(database)/documents/redeem_codes/$(code)).data.type == 'dev' &&
          get(/databases/$(database)/documents/redeem_codes/$(code)).data.restrictedToUid == request.auth.uid;

        // Never allow clients to delete redemption receipts
        allow delete: if false;
      }
    }
  }
}
